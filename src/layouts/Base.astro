---
interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
---
<!doctype html>
<html lang="es" data-type="product" data-radius="soft" data-buttons="solid" data-motion>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{title}</title>
<meta name="description" content={description}>
<meta name="site-kind" content="other">
<meta name="page-type" content="product">
<link rel="icon" type="image/png" href="/favicon-64.png">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wdth,wght@12..96,75..100,400..700&family=Figtree:wght@400..600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/assets/system.css">
<link rel="stylesheet" href="/assets/ui/cards.css">
<link rel="stylesheet" href="/assets/motion/motion.css">
<link rel="stylesheet" href="/assets/layout/layout.css">
<link rel="stylesheet" href="/assets/icons/icon.css">
<style is:global>
:root {
  --p-bg: #fbf4ec; --p-surface: #f3e6da; --p-ink: #3b2a24; --p-muted: #755f54;
  --p-accent: #b8445f; --p-accent-ink: #fbf4ec; --p-action: #b8445f; --p-action-ink: #fbf4ec;
  --p-inv-bg: #3b2a24; --p-inv-surface: #473630; --p-inv-ink: #fbf4ec; --p-inv-muted: #b3a79f;
  --p-inv-accent: #fbf4ec; --p-inv-accent-ink: #3b2a24; --p-inv-action: #fbf4ec; --p-inv-action-ink: #3b2a24;
  --font-display: "Bricolage Grotesque", system-ui, sans-serif;
  --font-text: "Figtree", system-ui, sans-serif;
  --display-weight: 400;
  --display-tracking: -0.03em;
  --display-tracking-xl: -0.04em;
  --display-stretch: 96%;
}
</style>
<link rel="stylesheet" href="/shop.css">
</head>
<body>
<!-- type: product (tienda con catálogo grande)
     deal: hero word (titular grande, sin foto), nav nav-split sin panel, close close-word,
           rhythm brand-band (Calidad), buttons solid; páginas de tienda, producto y pedido fluyen
           (no son secciones de una pantalla: son pantallas de uso)
     palette/type: colores de la marca (start.mjs brand), Bricolage Grotesque + Figtree, radius soft -->
<slot />
<script type="module" is:inline src="/assets/system.js"></script>
<script type="module" is:inline src="/assets/motion/motion.js"></script>
<script type="module" is:inline src="/assets/layout/layout.js"></script>
<script>
  import "../scripts/cart";
</script>
</body>
</html>
