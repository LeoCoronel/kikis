---
import { u, photoUrl } from "../config";
import { ESTADO_LABEL, money, slugify, tonoInicial, type Product } from "../lib/catalog";
interface Props {
  p: Product;
  order?: number; // posición en la planilla, para ordenar por "Novedades"
}
const { p, order = 0 } = Astro.props;
const href = u(`/producto/${p.slug}/`);
const out = p.estado === "agotado";
// fotos de cada tono (o las generales si el tono no tiene)
const fotosDe = (i: number) => (p.variantes[i]?.fotos.length ? p.variantes[i].fotos : p.fotos);
const inicial = tonoInicial(p);
const foto = photoUrl(p.variantes.length ? (fotosDe(inicial)[0] ?? p.fotoArchivo) : p.fotoArchivo, 600);
const estados = p.variantes.length ? [...new Set(p.variantes.map((v) => v.estado))].join(" ") : p.estado;
// texto de búsqueda sin tildes ni mayúsculas
const search = [p.nombre, p.marca, p.categoria, p.descripcion, ...p.tonos]
  .join(" ")
  .normalize("NFD")
  .replace(/[̀-ͯ]/g, "")
  .toLowerCase();
---
<article
  class="tile shop-card span-3"
  data-item
  data-id={p.id}
  data-name={p.nombre}
  data-brand={p.marca}
  data-price={p.precio}
  data-url={href}
  data-cat={p.categoria}
  data-estado={p.estado}
  data-estados={estados}
  data-order={order}
  data-search={search}
>
  <a class="tile__media" href={href} tabindex="-1" aria-hidden="true" data-media data-w="600">
    <span class={`shop-ph ph--${slugify(p.categoria)}`}><b>{p.marca || "Kiki's"}</b><small>{p.categoria}</small><img src={u("/kiki/kiki-retrato-96.webp")} alt="" width="36" height="36" loading="lazy" /></span>
    {foto && <img class="shop-photo" data-photo src={foto} alt="" width="600" height="600" loading="lazy" decoding="async" />}
  </a>
  <div class="tile__head">
    <h3><a href={href}>{p.nombre}</a></h3>
    <span class="tile__price">{money(p.precio)}</span>
  </div>
  <p class="tile__facts">{p.marca && `${p.marca} · `}<span data-estado-label>{ESTADO_LABEL[p.estado]}</span></p>
  {
    p.variantes.length > 0 && (
      <fieldset class="tones tones--card">
        <legend class="sr-only">Tono de {p.nombre}</legend>
        <div class="tones__row">
          {p.variantes.map((v, i) => (
            <label class:list={["tone", { "tone--out": v.estado === "agotado" }]}>
              <input type="radio" name={`tono-${p.id}`} value={v.nombre} data-tone-input data-estado={v.estado} data-fotos={JSON.stringify(fotosDe(i))} checked={i === inicial} />
              <span>{v.nombre}</span>
            </label>
          ))}
        </div>
      </fieldset>
    )
  }
  <button class="btn btn--secondary shop-card__add" type="button" data-add disabled={out}>{out ? "Agotado" : "Agregar al pedido"}</button>
</article>
