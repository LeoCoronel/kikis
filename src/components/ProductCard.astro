---
import { ESTADO_LABEL, money, slugify, fotoDe, type Product } from "../lib/catalog";
interface Props {
  p: Product;
  order?: number; // posición en la planilla, para ordenar por "Novedades"
}
const { p, order = 0 } = Astro.props;
const href = `/producto/${p.slug}/`;
const out = p.estado === "agotado";
const foto = fotoDe(p, 600);
// texto de búsqueda sin tildes ni mayúsculas
const search = [p.nombre, p.marca, p.categoria, p.descripcion]
  .join(" ")
  .normalize("NFD")
  .replace(/[̀-ͯ]/g, "")
  .toLowerCase();
---
<article
  class="tile shop-card span-3"
  data-item
  data-id={p.id}
  data-name={p.nombre}
  data-brand={p.marca}
  data-price={p.precio}
  data-url={href}
  data-cat={p.categoria}
  data-estado={p.estado}
  data-order={order}
  data-search={search}
>
  <a class="tile__media" href={href} tabindex="-1" aria-hidden="true">
    <span class={`shop-ph ph--${slugify(p.categoria)}`}><b>{p.marca || "Kiki's"}</b><small>{p.categoria}</small><img src="/kiki/kiki-retrato-96.webp" alt="" width="36" height="36" loading="lazy" /></span>
    {foto && <img class="shop-photo" data-photo src={foto} alt="" width="600" height="600" loading="lazy" decoding="async" />}
  </a>
  <div class="tile__head">
    <h3><a href={href}>{p.nombre}</a></h3>
    <span class="tile__price">{money(p.precio)}</span>
  </div>
  <p class="tile__facts">{[p.marca, ESTADO_LABEL[p.estado]].filter(Boolean).join(" · ")}</p>
  {
    out ? (
      <button class="btn btn--secondary" type="button" disabled>Agotado</button>
    ) : p.tonos.length > 0 ? (
      <a class="btn btn--secondary" href={`${href}#tonos`}>Elegir tono</a>
    ) : (
      <button class="btn btn--secondary" type="button" data-add>Agregar al pedido</button>
    )
  }
</article>
