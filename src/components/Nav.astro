---
import { SITE, u } from "../config";
---
<header class="nav nav--split">
  <div class="wrap nav__bar">
    <nav class="nav__links" aria-label="Principal">
      <div class="nav__item"><a class="nav__link" href={u("/tienda/")}>Tienda</a></div>
      <div class="nav__item"><a class="nav__link" href={u("/combos/")}>Combos</a></div>
      <div class="nav__item"><a class="nav__link" href={u("/#calidad")}>Calidad</a></div>
      <div class="nav__item"><a class="nav__link" href={u("/#como-comprar")}>Cómo comprar</a></div>
    </nav>
    <a class="nav__logo" href={u("/")}><img src={u("/kiki/kiki-retrato-96.webp")} alt="" width="32" height="32">Kiki's makeup</a>
    <div class="nav__actions">
      <a class="btn btn--primary" href={u("/pedido/")}>{SITE.mainAction}<span class="badge nav__count" data-cart-count hidden>0</span></a>
    </div>
    <button class="nav__toggle" type="button" aria-expanded="false" aria-label="Menú">
      <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="M2 5h14M2 13h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
    </button>
  </div>
</header>
